<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <AssemblyName>DNCefView.Avalonia</AssemblyName>
    <AssemblyTitle>DNCefView.Avalonia</AssemblyTitle>
    <RootNamespace>DNCefView.Avalonia</RootNamespace>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Description>An Avalonia implementation of DNCefView</Description>
    <PackageProjectUrl>https://github.com/CefView/DNCefView.Avalonia</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CefView/DNCefView.Avalonia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>WebView;CEF;CefView;DNCefView;Aavalonia</PackageTags>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DNCefView\DNCefView.csproj" />
  </ItemGroup>

</Project>
